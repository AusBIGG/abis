     dc:format "text/turtle";
     dc:creator "Biodiversity Information Standards (TDWG)";
     dcterms:references <http://rs.tdwg.org/dwc/terms/geologicMaterialNameID>;
     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/measuredChemistry>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Measured Chemistry"@en;
     skos:prefLabel "Measured Chemistry"@en;
     rdfs:comment "A concise expression of the chemical composition of a mineral that shows the number of atoms of each element in a molecule, their spatial arrangement, and their linkage to each other."@en;
     skos:definition "A concise expression of the chemical composition of a mineral that shows the number of atoms of each element in a molecule, their spatial arrangement, and their linkage to each other."@en;
     skos:example "`SiO2 (65.76)`; `TiO2 (32.120)`; `Al2O3 (2.21)`; `(Mg0.77Fe0.23)2SiO4`; `An6.4 Ab73.6 Or20`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

<http://rs.tdwg.org/dwc/terms/version/measuredChemistry-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/measuredChemistry>.

<http://rs.tdwg.org/dwc/terms/measuredChemistry>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/measuredChemistry-2026-10-13>.

<http://rs.tdwg.org/dwc/terms/measuredChemistry.ttl>
     dc:format "text/turtle";
     dc:creator "Biodiversity Information Standards (TDWG)";
     dcterms:references <http://rs.tdwg.org/dwc/terms/measuredChemistry>;
     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/measuredChemistrySource>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Measured Chemistry Source"@en;
     skos:prefLabel "Measured Chemistry Source"@en;
     rdfs:comment "A list (concatenated and separated) of resources associated with the reported measured chemistry described specifically enough to allow anyone in the future to use the same resources."@en;
     skos:definition "A list (concatenated and separated) of resources associated with the reported measured chemistry described specifically enough to allow anyone in the future to use the same resources."@en;
     dcterms:description "Recommended best practice is to use full bibliographic citations, global unique identifiers, or resolvable and persistent IRIs. See the broader concept http://rs.tdwg.org/dwc/terms/associatedReferences. This term has an equivalent in the dwciri: namespace that allows only an IRI as a value, whereas this term allows for any string literal value."@en;
     skos:example "`Novak, G. A., & Gibbs, G. V. (1971). The crystal chemistry of the silicate garnets. American Mineralogist: Journal of Earth and Planetary Materials, 56(5-6), 791-825.`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

<http://rs.tdwg.org/dwc/terms/version/measuredChemistrySource-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/measuredChemistrySource>.

<http://rs.tdwg.org/dwc/terms/measuredChemistrySource>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/measuredChemistrySource-2026-10-13>.

<http://rs.tdwg.org/dwc/terms/measuredChemistrySource.ttl>
     dc:format "text/turtle";
     dc:creator "Biodiversity Information Standards (TDWG)";
     dcterms:references <http://rs.tdwg.org/dwc/terms/measuredChemistrySource>;
     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/mineralogicalAnalysisProtocol>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Mineralogical Analysis Protocol"@en;
     skos:prefLabel "Mineralogical Analysis Protocol"@en;
     rdfs:comment "A technique used to determine the chemical composition or crystallography of a mineral."@en;
     skos:definition "A technique used to determine the chemical composition or crystallography of a mineral."@en;
     dcterms:description "Acronyms should be avoided even for widely recognized annotations. Recommended best practice is to use a controlled vocabulary such as https://vocabs.ardc.edu.au/viewById/650. This term has an equivalent in the dwciri: namespace that allows only an IRI as a value, whereas this term allows for any string literal value."@en;
     skos:example "`Wet Chemistry`; `X-ray fluorescence`; `Electron probe microanalysis`; `Scanning electron microscopy with energy-dispersive X-ray spectroscopy`; `X-ray diffraction`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

<http://rs.tdwg.org/dwc/terms/version/mineralogicalAnalysisProtocol-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/mineralogicalAnalysisProtocol>.

<http://rs.tdwg.org/dwc/terms/mineralogicalAnalysisProtocol>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/mineralogicalAnalysisProtocol-2026-10-13>.

<http://rs.tdwg.org/dwc/terms/mineralogicalAnalysisProtocol.ttl>
     dc:format "text/turtle";
     dc:creator "Biodiversity Information Standards (TDWG)";
     dcterms:references <http://rs.tdwg.org/dwc/terms/mineralogicalAnalysisProtocol>;
     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/mineralSequence>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Mineral Sequence"@en;
     skos:prefLabel "Mineral Sequence"@en;
     rdfs:comment "A list (concatenated and separated) of minerals in a dwc:GeologicalMaterial, ordered in a manner that illustrates the relative timing of mineral formation."@en;
     skos:definition "A list (concatenated and separated) of minerals in a dwc:GeologicalMaterial, ordered in a manner that illustrates the relative timing of mineral formation."@en;
     dcterms:description "The list should only contain minerals that belong to a readily identifiable sequence of formation. Therefore, a list may contain a subset of the minerals in a specimen. Minerals that formed in-situ with one another are separated by a plus. Minerals that formed in the sequence are separated by a greater than (' > ') symbol."@en;
     skos:example "`Sphalerite > Quartz > Pyrite`; `Calcite > Quartz > Sphalerite > Pyrite`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

<http://rs.tdwg.org/dwc/terms/version/mineralSequence-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/mineralSequence>.

