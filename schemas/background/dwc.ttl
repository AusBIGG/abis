<http://rs.tdwg.org/dwc/terms/hazardRemarks>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Hazard Remarks"@en;
     skos:prefLabel "Hazard Remarks"@en;
     rdfs:comment "Comments or notes about the type of hazards associated with a dwc:MaterialEntity."@en;
     skos:definition "Comments or notes about the type of hazards associated with a dwc:MaterialEntity."@en;
     skos:example "`asbestos`; `slightly radioactive`; `requires skin protection`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/MaterialEntity>;
     tdwgutility:usageScope "simple".

