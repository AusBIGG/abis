     dc:format "text/turtle";
     dc:creator "Biodiversity Information Standards (TDWG)";
     dcterms:references <http://rs.tdwg.org/dwc/terms/classificationCodes>;
     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/geologicalMaterialNames>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Geological Material Names"@en;
     skos:prefLabel "Geological Material Names"@en;
     rdfs:comment "A list (concatenated and separated) of mineral or lithotaxon names for a dwc:GeologicalMaterial."@en;
     skos:definition "A list (concatenated and separated) of mineral or lithotaxon names for a dwc:GeologicalMaterial."@en;
     dcterms:description "May includes both informal (e.g., variety, synonym) and formal (classification) names. The first name in the list should be considered the preferred name. Recommended best practice is to separate the values in a list with space vertical bar space (` | `)."@en;
     skos:example "`quartz | smoky quartz`; `muscovite`; `garnet group`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

<http://rs.tdwg.org/dwc/terms/version/geologicalMaterialNames-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/geologicalMaterialNames>.

<http://rs.tdwg.org/dwc/terms/geologicalMaterialNames>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/geologicalMaterialNames-2026-10-13>.

<http://rs.tdwg.org/dwc/terms/geologicalMaterialNames.ttl>
     dc:format "text/turtle";
     dc:creator "Biodiversity Information Standards (TDWG)";
     dcterms:references <http://rs.tdwg.org/dwc/terms/geologicalMaterialNames>;
     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/geologicalMaterialNameTypes>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Geological Material Name Types"@en;
     skos:prefLabel "Geological Material Name Types"@en;
     rdfs:comment "A list (concatenated and separated) of the types of names provided in dwc:geologicalMaterialNames."@en;
     skos:definition "A list (concatenated and separated) of the types of names provided in dwc:geologicalMaterialNames."@en;
     dcterms:description "If this term is populated, it should have an equal number of items in the list as for the list in dwc:geologicalMaterialNames and the types should have the same order as the names to which they refer. Recommended best practice is to use a controlled vocabulary for the values in a list (e.g., https://kos.geospecimens.org/def/geological-specimen-name-type). See Gavryliv (2023), https://doi.org/10.1180/mgm.2023.23, for a detailed breakdown of informal, alternate names."@en;
     skos:example "`species | variety`; `species`; `group`;  `synonym`; `classification`; `historical`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

<http://rs.tdwg.org/dwc/terms/version/geologicalMaterialNameTypes-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/geologicalMaterialNameTypes>.

<http://rs.tdwg.org/dwc/terms/geologicalMaterialNameTypes>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/geologicalMaterialNameTypes-2026-10-13>.

<http://rs.tdwg.org/dwc/terms/geologicalMaterialNameTypes.ttl>
     dc:format "text/turtle";
     dc:creator "Biodiversity Information Standards (TDWG)";
     dcterms:references <http://rs.tdwg.org/dwc/terms/geologicalMaterialNameTypes>;
     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/geologicMaterialNameID>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Geologic Material Name ID"@en;
     skos:prefLabel "Geologic Material Name ID"@en;
     rdfs:comment "An identifier for a mineral or lithotaxon name for a dwc:GeologicalMaterial. May be a global unique identifier or an identifier specific to the data set."@en;
     skos:definition "An identifier for a mineral or lithotaxon name for a dwc:GeologicalMaterial. May be a global unique identifier or an identifier specific to the data set."@en;
     dcterms:description "Recommended best practice is to use a persistent, globally unique identifier."@en;
     skos:example "`https://geospecimens.org/api/v1/catalog/resource/mineral-name/ba673bdf-7228-11f0-a057-52f8e1bb0628`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

<http://rs.tdwg.org/dwc/terms/version/geologicMaterialNameID-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/geologicMaterialNameID>.

<http://rs.tdwg.org/dwc/terms/geologicMaterialNameID>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/geologicMaterialNameID-2026-10-13>.

