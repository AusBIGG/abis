     a foaf:document.

<http://rs.tdwg.org/dwc/terms/lithodemicUnit>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Lithodemic Unit"@en;
     skos:prefLabel "Lithodemic Unit"@en;
     rdfs:comment "A geologic unit that lacks stratification, is primarily comprised of intrusive, deformed, and/or metamorphosed rock, and is characterized by irregularly mixed lithology or highly complicated structural relations."@en;
     skos:definition "A geologic unit that lacks stratification, is primarily comprised of intrusive, deformed, and/or metamorphosed rock, and is characterized by irregularly mixed lithology or highly complicated structural relations."@en;
     dcterms:description "Due to the unstructured nature of complexes, both named units and lithological descriptive terms are acceptable values."@en;
     skos:example "`Catalina Core Complex`; `injection complex`; `New England Plutonic Suite`; `Sierra Nevada batholith`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalContext>;
     tdwgutility:usageScope "simple".

<http://rs.tdwg.org/dwc/terms/version/lithodemicUnit-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/lithodemicUnit>.

<http://rs.tdwg.org/dwc/terms/lithodemicUnit>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/lithodemicUnit-2026-10-13>.

