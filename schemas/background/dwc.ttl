<http://rs.tdwg.org/dwc/terms/sampledFeatureType>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Sampled Feature Type"@en;
     skos:prefLabel "Sampled Feature Type"@en;
     rdfs:comment "The type of naturally occurring or anthropogenic physical feature from which a dwc:MaterialEntity was sampled."@en;
     skos:definition "The type of naturally occurring or anthropogenic physical feature from which a dwc:MaterialEntity was sampled."@en;
     dcterms:description "This term has an equivalent in the dwciri: namespace that allows only an IRI as a value, whereas this term allows for any string literal value."@en;
     skos:example "`float`; `mine dump`; `mine/quarry pit`; `outcrop`; `erratic boulder`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/MaterialEntity>;
     tdwgutility:usageScope "simple".

