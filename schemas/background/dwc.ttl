     a foaf:document.

<http://rs.tdwg.org/dwc/terms/materialProportion>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Material Proportion"@en;
     skos:prefLabel "Material Proportion"@en;
     rdfs:comment "The qualitative or quantitative abundance of a dwc:MaterialEntity with respect to another dwc:MaterialEntity of which it is a part."@en;
     skos:definition "The qualitative or quantitative abundance of a dwc:MaterialEntity with respect to another dwc:MaterialEntity of which it is a part."@en;
     dcterms:description "Recommended best practice is to use a controlled vocabulary such as http://resource.geosciml.org/classifier/cgi/proportionterm. This term has an equivalent in the dwciri: namespace that allows only an IRI as a value, whereas this term allows for any string literal value."@en;
     skos:example "`20%`; `minor`;  `dominant`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/MaterialEntity>;
     tdwgutility:usageScope "simple".

<http://rs.tdwg.org/dwc/terms/version/materialProportion-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/materialProportion>.

