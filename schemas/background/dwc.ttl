     rdfs:label "Event Time"@en;
     skos:prefLabel "Event Time"@en;
     rdfs:comment "The time or interval during which a dwc:Event occurred."@en;
     skos:definition "The time or interval during which a dwc:Event occurred."@en;
     dcterms:description "Recommended best practice is to use a time of day that conforms to ISO 8601-1:2019."@en;
     skos:example "`14:07-06:00` (at or after 2:07pm and before 2:08pm in the time zone six hours earlier than UTC); `08:40:21Z` (at or after 8:40:21am and before 8:41:22am UTC); `13:00:00Z/15:30:00Z` (at or after 1pm and before 3:30pm UTC)"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "accessible from DataSets/DataSet/Units/Unit/Gathering/ISODateTimeBegin and DataSets/DataSet/Units/Unit/Gathering/ISODateTimeEnd";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/Event>;
     tdwgutility:usageScope "simple".

