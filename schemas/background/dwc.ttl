     dcterms:modified "2026-10-13T00:00:00-03:00"^^xsd:dateTime;
     a foaf:document.

<http://rs.tdwg.org/dwc/terms/tectonicUnits>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Tectonic Units"@en;
     skos:prefLabel "Tectonic Units"@en;
     rdfs:comment "The combination of all tectonic unit names for the rock from which a dwc:MaterialEntity was collected."@en;
     skos:definition "The combination of all tectonic unit names for the rock from which a dwc:MaterialEntity was collected."@en;
     dcterms:description "Recommended best practice is to use an authoritative tectonic unit lexicon such as the Tectonic Map of Switzerland (TK500). This term has an equivalent in the dwciri: namespace that allows only an IRI as a value, whereas this term allows for any string literal value."@en;
     skos:example "`Upper Helvetic`; `Wildhorn Nappe Complex`; `Sublage Nappe`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalContext>;
     tdwgutility:usageScope "simple".

<http://rs.tdwg.org/dwc/terms/version/tectonicUnits-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/tectonicUnits>.

<http://rs.tdwg.org/dwc/terms/tectonicUnits>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/tectonicUnits-2026-10-13>.

