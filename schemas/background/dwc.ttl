<http://rs.tdwg.org/dwc/terms/isPartOfMaterialEntityID>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Is Part Of MaterialEntity ID"@en;
     skos:prefLabel "Is Part Of MaterialEntity ID"@en;
     rdfs:comment "An identifier for a dwc:MaterialEntity of which this dwc:MaterialEntity is a part."@en;
     skos:definition "An identifier for a dwc:MaterialEntity of which this dwc:MaterialEntity is a part."@en;
     dcterms:description "A dwc:MaterialEntity was not taken from (derived from) a dwc:MaterialEntity of which it is a part. Recommended best practice is to use a globally unique identifier. The hierarchical relationship supported by this term allows for the atomization of individual parts of a dwc:MaterialEntity, such as a specimen composed of two minerals (Pyrite and Quartz), each with its own characteristics and potential dwc:Assertions."@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/MaterialEntity>;
     tdwgutility:usageScope "simple".

<http://rs.tdwg.org/dwc/terms/version/isPartOfMaterialEntityID-2026-10-13>
     dcterms:isVersionOf <http://rs.tdwg.org/dwc/terms/isPartOfMaterialEntityID>.

<http://rs.tdwg.org/dwc/terms/isPartOfMaterialEntityID>
     dcterms:hasVersion <http://rs.tdwg.org/dwc/terms/version/isPartOfMaterialEntityID-2026-10-13>.

