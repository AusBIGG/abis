<http://rs.tdwg.org/dwc/terms/taxonRank>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2009-04-24"^^xsd:date;
     dcterms:modified "2026-05-26"^^xsd:date;
     dcterms:replaces <http://rs.tdwg.org/dwc/terms/scientificNameRank>;
     rdfs:label "Taxon Rank"@en;
     skos:prefLabel "Taxon Rank"@en;
     rdfs:comment "The taxonomic rank of the most specific name in the dwc:scientificName."@en;
     skos:definition "The taxonomic rank of the most specific name in the dwc:scientificName."@en;
     dcterms:description "Recommended best practice is to use a controlled vocabulary. The taxon ranks of algae, fungi and plants are defined in the International Code of Nomenclature for algae, fungi, and plants (Shenzhen Code Articles H3.2, H4.4 and H.3.1)."@en;
     skos:example "`subspecies`; `varietas`; `forma`; `species`; `genus`; `nothogenus`; `nothospecies`; `nothosubspecies`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "DataSets/DataSet/Units/Unit/Identifications/Identification/TaxonIdentified/ScientificName/NameAtomised/Botanical/Rank";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/Taxon>;
     tdwgutility:usageScope "simple".

