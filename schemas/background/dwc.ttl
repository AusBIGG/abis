<http://rs.tdwg.org/dwc/terms/recordNumber>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2009-04-24"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     dcterms:replaces <http://rs.tdwg.org/dwc/curatorial/CollectorNumber>;
     rdfs:label "Record Number"@en;
     skos:prefLabel "Record Number"@en;
     rdfs:comment "An identifier given to the dwc:Occurrence at the time it was recorded. Often serves as a link between field notes and a dwc:MaterialEntity record, such as a specimen collector's number."@en;
     skos:definition "An identifier given to the dwc:Occurrence at the time it was recorded. Often serves as a link between field notes and a dwc:MaterialEntity record, such as a specimen collector's number."@en;
     dcterms:description "This term has an equivalent in the dwciri: namespace that allows only an IRI as a value, whereas this term allows for any string literal value."@en;
     skos:example "`OPP 7101`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "DataSets/DataSet/Units/Unit/CollectorsFieldNumber";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/Occurrence>;
     tdwgutility:usageScope "simple".

