<http://rs.tdwg.org/dwc/terms/verbatimIdentification>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2021-07-15"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Verbatim Identification"@en;
     skos:prefLabel "Verbatim Identification"@en;
     rdfs:comment "A string representing the classification as it appeared in the original record."@en;
     skos:definition "A string representing the classification as it appeared in the original record."@en;
     dcterms:description "This term is meant to allow the capture of an unaltered original identification/determination, including identification qualifiers, hybrid formulas, uncertainties, etc. This term is meant to be used in addition to dwc:geologicalMaterialNames or dwc:scientificName (and dwc:identificationQualifier etc.), not instead of it."@en;
     skos:example "`Peromyscus sp.`; `Ministrymon sp. nov. 1`; `Anser anser × Branta canadensis`; `Pachyporidae?`; `Potentilla × pantotricha Soják`; `Aconitum pilipes × A. variegatum`; `Lepomis auritus x cyanellus`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
