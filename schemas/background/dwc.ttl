<http://rs.tdwg.org/dwc/terms/associatedReferences>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2009-04-24"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Associated References"@en;
     skos:prefLabel "Associated References"@en;
     rdfs:comment "A list (concatenated and separated) of associated dcterms:BibliographicResources."@en;
     skos:definition "A list (concatenated and separated) of associated dcterms:BibliographicResources."@en;
     dcterms:description "Recommended best practice is to separate the values in a list with space vertical bar space ( | ). Note that the intended usage of the term dcterms:references in Darwin Core is to point to the definitive source representation of the resource, if one is available. Note also that the intended usage of dcterms:bibliographicCitation in Darwin Core is to provide the preferred way to cite the resource itself."@en;
     skos:example "`Christopher J. Conroy, Jennifer L. Neuwald. 2008. Phylogeographic study of the California vole, Microtus californicus Journal of Mammalogy, 89(3):755-767.`; `Steven R. Hoofer and Ronald A. Van Den Bussche. 2001. Phylogenetic Relationships of Plecotine Bats and Allies Based on Mitochondrial Ribosomal Sequences. Journal of Mammalogy 82(1):131-137. | Walker, Faith M., Jeffrey T. Foster, Kevin P. Drees, Carol L. Chambers. 2014. Spotted bat (Euderma maculatum) microsatellite discovery using illumina sequencing. Conservation Genetics Resources.`; `https://doi.org/10.3897/BDJ.14.e177525`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "DataSets/DataSet/Units/Unit/UnitReferences";
     tdwgutility:usageScope "simple".

