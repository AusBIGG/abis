<http://rs.tdwg.org/dwc/terms/damageRemarks>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Damage Remarks"@en;
     skos:prefLabel "Damage Remarks"@en;
     rdfs:comment "A general description of any physical changes to a dwc:MaterialEntity that have negatively affected its value."@en;
     skos:definition "A general description of any physical changes to a dwc:MaterialEntity that have negatively affected its value."@en;
     dcterms:description "See Royce, K., Baars, C., & Viles, H. (2021). Defining Damage and Susceptibility, with Implications for Mineral Specimens and Objects: Introducing the Mineral Susceptibility Database. Studies in Conservation, 68(3), 298-317. https://doi.org/10.1080/00393630.2021.2015947"@en;
     skos:example "`Due to oxidation and hydration of the pyrite in the coal, the sample has largely decayed to a coal powder with some larger coal pieces | Some terminations broken off | Attached label not legible (or torn, or covered)`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/MaterialEntity>;
     tdwgutility:usageScope "simple".

