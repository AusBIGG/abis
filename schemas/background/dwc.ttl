     a foaf:document.

<http://rs.tdwg.org/dwc/terms/materialDescription>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Material Description"@en;
     skos:prefLabel "Material Description"@en;
     rdfs:comment "Remarks on the physical characteristics of a dwc:MaterialEntity, particularly those that distinguish it from otherwise similar dwc:MaterialEntities."@en;
     skos:definition "Remarks on the physical characteristics of a dwc:MaterialEntity, particularly those that distinguish it from otherwise similar dwc:MaterialEntities."@en;
     skos:example "`Showpiece`; `Historically valuable`; `Extraordinary composition`; `Two generations of quartz`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/MaterialEntity>;
     tdwgutility:usageScope "simple".

