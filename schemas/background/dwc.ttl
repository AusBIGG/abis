     a foaf:document.

<http://rs.tdwg.org/dwc/terms/chemistryRemarks>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2026-10-13"^^xsd:date;
     dcterms:modified "2026-10-13"^^xsd:date;
     rdfs:label "Chemistry Remarks"@en;
     skos:prefLabel "Chemistry Remarks"@en;
     rdfs:comment "General remarks about the chemical and isotopic composition of a dwc:GeologicalMaterial."@en;
     skos:definition "General remarks about the chemical and isotopic composition of a dwc:GeologicalMaterial."@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "not in ABCD";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/GeologicalMaterial>;
     tdwgutility:usageScope "extension".

