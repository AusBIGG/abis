<http://rs.tdwg.org/dwc/terms/superfamily>
     rdfs:isDefinedBy <http://rs.tdwg.org/dwc/terms/>;
     dcterms:isPartOf <http://rs.tdwg.org/dwc/terms/>;
     dcterms:created "2023-06-28"^^xsd:date;
     dcterms:modified "2023-07-07"^^xsd:date;
     rdfs:label "Superfamily"@en;
     skos:prefLabel "Superfamily"@en;
     rdfs:comment "The full scientific name of the superfamily in which the dwc:Taxon is classified."@en;
     skos:definition "The full scientific name of the superfamily in which the dwc:Taxon is classified."@en;
     dcterms:description "A taxonomic category subordinate to an order and superior to a family. According to ICZN article 29.2, the suffix `-oidea` is used for a superfamily name."@en;
     skos:example "`Achatinoidea`; `Cerithioidea`; `Helicoidea`; `Hypsibioidea`; `Valvatoidea`; `Zonitoidea`"@en;
     rdf:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>;
     tdwgutility:abcdEquivalence "ScientificNameIdentified/HigherTaxon/HigherTaxonRank (enumeration value: superfamilia)";
     tdwgutility:organizedInClass <http://rs.tdwg.org/dwc/terms/Taxon>;
     tdwgutility:usageScope "simple".

